{
  // codespaces上で表示されるラベル名
  "name": "Laravel Dev Container",
  // ターゲットのdocker-compoaseファイルを指定
  "dockerComposeFile": "./docker-compose.yml",
  // 開発環境を構築するコンテナ（docker-compose.ymlのservicesと連動）
  "service": "php-fpm",
  // コンテナ作成時に開くフォルダ
  "workspaceFolder": "/var/www"
